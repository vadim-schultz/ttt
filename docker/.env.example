# Example .env file for Docker build configuration
# Copy this to .env and customize for your environment
# IMPORTANT: .env is gitignored - never commit it!

# Docker pull-through registry (leave as docker.io for public, or use corporate mirror)
DOCKER_REGISTRY=docker.io

# NPM registry (leave as public npmjs.org, or use corporate mirror)
NPM_REGISTRY=https://registry.npmjs.org/

# Python package index URLs (leave empty for public PyPI, or set corporate mirrors)
PYPI_INDEX_URL=
PYPI_EXTRA_INDEX_URL=

# HTTP/HTTPS proxy settings (leave empty if not behind a corporate proxy)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
